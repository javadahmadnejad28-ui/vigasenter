{
  "name": "vegasenter",
  "version": "1.0.0",
  "private": true,
  "description": "ویجاسنتر — سامانه مدیریت موجودی، کاتالوگ قیمت زنده و صدور فاکتور (Vite + React + Cloudflare Pages + D1)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "pages:dev": "wrangler pages dev dist --compatibility-date 2025-09-01 --d1 DB=shop-db",
    "pages:deploy": "wrangler pages deploy dist",
    "db:init": "wrangler d1 execute shop-db --remote --file=./schema.sql",
    "db:init:local": "wrangler d1 execute shop-db --local --file=./schema.sql",
    "db:seed": "wrangler d1 execute shop-db --remote --file=./seed.sql"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "next-themes": "^0.4.6",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.2",
    "lucide-react": "^0.525.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "wrangler": "^3.95.0"
  }
}
